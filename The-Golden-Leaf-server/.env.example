DB_NAME=datban_db
DB_USERNAME=datban
DB_PASSWORD=change-this-local-password
DB_ROOT_PASSWORD=change-this-root-password
DB_HOST_PORT=3308
BACKEND_PORT=8080
FIREBASE_ENABLED=false
REQUIRE_AUTH=false
BOOKING_HOLD_DURATION=PT15M
RESTAURANT_TIME_ZONE=Asia/Ho_Chi_Minh
