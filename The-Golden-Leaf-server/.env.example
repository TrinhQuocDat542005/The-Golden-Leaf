DB_NAME=datban_db
SPRING_PROFILES_ACTIVE=dev
DB_USERNAME=datban
DB_PASSWORD=change-this-local-password
DB_ROOT_PASSWORD=change-this-root-password
DB_HOST_PORT=3308
BACKEND_PORT=8080
FIREBASE_ENABLED=false
FIREBASE_WEB_API_KEY=
# Actual restaurant receiving account. Leave empty to disable new payment requests.
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=
REQUIRE_AUTH=false
BOOKING_HOLD_DURATION=PT15M
RESTAURANT_TIME_ZONE=Asia/Ho_Chi_Minh
BOOKING_EXPIRY_DELAY_MS=60000
BOOKING_TABLE_FEE=200000.00
# Set both values below when Firebase is enabled.
FIREBASE_CREDENTIALS_HOST_PATH=./secrets/firebase-service-account.json
