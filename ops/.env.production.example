# Compose invoked from repository root; provide real secret files in ops/secrets/.
BACKEND_IMAGE=golden-leaf:REPLACE_WITH_VERIFIED_COMMIT_SHA
DB_NAME=datban_db
DB_USERNAME=datban
FIREBASE_WEB_API_KEY=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=
# Random >=32 characters; never Firebase tokens. Store in env restricted to deployment operator.
MONITORING_TOKEN=
RESTAURANT_TIME_ZONE=Asia/Ho_Chi_Minh
BOOKING_TABLE_FEE=200000.00
# Backend sees proxy address: aggregate safety limit per replica. Edge does real per-IP limiting.
RATE_LIMIT_REQUESTS_PER_MINUTE=3000
# false on isolated restore rehearsal/staging; never push to real devices from restored DB.
PUSH_DELIVERY_ENABLED=true
